@startuml UC_Sistem_Ananda
' ============================================================
' USE CASE DIAGRAM
' Sistem Informasi Keuangan Sekolah Ananda
' ============================================================

skinparam usecase {
  BackgroundColor #FFFDE7
  BorderColor #F57F17
  ArrowColor #37474F
  ActorBorderColor #1565C0
  ActorBackgroundColor #E3F2FD
  ActorFontSize 13
  ActorFontStyle Bold
}
skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #546E7A
  BorderThickness 2
  FontSize 14
  FontStyle Bold
}
skinparam note {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
  FontSize 11
}
skinparam ArrowFontSize 10

left to right direction

' ============================
' AKTOR
' ============================
actor ":Admin\nSistem" as Admin #E8EAF6
actor ":Bendahara" as Bendahara #E0F2F1
actor ":Kepala\nSekolah" as Kepsek #FFF8E1
actor ":Kepala\nYayasan" as Yayasan #FCE4EC
actor ":Orang Tua\n/ Wali" as OrangTua #F1F8E9

' ============================
' SISTEM BOUNDARY
' ============================
rectangle "Sistem Informasi Keuangan Sekolah Ananda" {

  ' --- AUTENTIKASI ---
  package "Autentikasi" as PKG_AUTH {
    usecase "Login ke Sistem" as UC01
    usecase "Logout" as UC02
    usecase "Ubah Password" as UC03
  }

  ' --- DASHBOARD ---
  package "Dashboard & Monitoring" as PKG_DASH {
    usecase "Lihat Dashboard\n& Statistik Keuangan" as UC04
    usecase "Lihat Ringkasan\nTunggakan Siswa" as UC05
    usecase "Lihat Log\nAktivitas Sistem" as UC06
  }

  ' --- DATA MASTER ---
  package "Manajemen Data Master" as PKG_MASTER {
    usecase "Kelola Data Siswa\n(Tambah/Edit/Hapus)" as UC07
    usecase "Kelola Data Kelas" as UC08
    usecase "Kelola Data Guru" as UC09
    usecase "Kelola Tahun Ajaran\n& Set Aktif" as UC10
    usecase "Kelola Pengguna\n& Hak Akses" as UC11
    usecase "Assign Akun Ortu\nke Siswa" as UC12
    usecase "Pengaturan Profil\nSekolah" as UC13
    usecase "Kelola Kategori\nTagihan" as UC14
    usecase "Kelola Kategori\nKeuangan" as UC15
  }

  ' --- TAGIHAN ---
  package "Manajemen Tagihan" as PKG_TAGIHAN {
    usecase "Buat Tagihan Massal\n(Per Kelas / Semua)" as UC16
    usecase "Buat Tagihan Manual\n(Per Siswa)" as UC17
    usecase "Lihat & Filter\nDaftar Tagihan" as UC18
    usecase "Edit / Hapus\nTagihan" as UC19
    usecase "Lihat Tagihan\nMilik Anak" as UC20
  }

  ' --- PEMBAYARAN ---
  package "Manajemen Pembayaran" as PKG_BAYAR {
    usecase "Input Pembayaran\nTunai (Manual)" as UC21
    usecase "Upload Bukti\nTransfer / QRIS" as UC22
    usecase "Validasi & Setujui\nPembayaran" as UC23
    usecase "Tolak Pembayaran\n& Beri Keterangan" as UC24
    usecase "Cetak / Unduh\nKwitansi Lunas" as UC25
    usecase "Lihat Riwayat\nPembayaran Anak" as UC26
  }

  ' --- TRANSAKSI KAS ---
  package "Transaksi Kas (Buku Kas)" as PKG_KAS {
    usecase "Catat Kas Masuk\nManual" as UC27
    usecase "Catat Kas Keluar\n(Pengeluaran)" as UC28
    usecase "Lihat Buku Kas\nHarian / Periode" as UC29
  }

  ' --- TABUNGAN ---
  package "Tabungan Siswa" as PKG_TAB {
    usecase "Setor Tabungan\nSiswa" as UC30
    usecase "Tarik Tabungan\nSiswa" as UC31
    usecase "Lihat Saldo &\nRiwayat Mutasi" as UC32
  }

  ' --- PENGGAJIAN ---
  package "Penggajian Guru" as PKG_GAJI {
    usecase "Buat Data\nPenggajian Guru" as UC33
    usecase "Edit Komponen\nGaji (Tunjangan/Potongan)" as UC34
    usecase "Proses & Tandai\nGaji Dibayar" as UC35
    usecase "Cetak Slip Gaji" as UC36
  }

  ' --- LAPORAN ---
  package "Laporan & Ekspor" as PKG_LAP {
    usecase "Laporan Arus Kas\n(Pemasukan & Pengeluaran)" as UC37
    usecase "Laporan Rekapitulasi\nPembayaran Siswa" as UC38
    usecase "Laporan Tunggakan\nSiswa Aktif" as UC39
    usecase "Laporan Tabungan\nSiswa" as UC40
    usecase "Laporan Penggajian\nGuru" as UC41
    usecase "Ekspor Laporan\nke PDF / Excel" as UC42
  }
}

